# Copy to .env (never commit .env) and fill in. docker compose reads it automatically.

# Production only (docker-compose.prod.yml): domain whose DNS A record points to the server.
DOMAIN=tokens.example.com

# Database credentials. Required in production: use a long random password (openssl rand -base64 24).
DB_USER=token_tracker
DB_PASSWORD=

# Signs the login tokens. Generate with: openssl rand -base64 32
# Required in production. In development, left empty, a random key is used and everyone is logged out on restart.
JWT_SECRET=

# Admin account, created at first startup (its password is never overwritten afterwards).
# Required in production. In development, left empty, no admin exists.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
